{
	"name": "@bigbrowser/chrome",
	"version": "4.0.0",
	"description": "Big Browser extension for Chrome (Manifest V3)",
	"private": true,
	"scripts": {
		"build": "webpack --mode production",
		"dev": "webpack --mode development --watch",
		"typecheck": "tsc --noEmit",
		"icons": "node scripts/make-icons.js icons",
		"zip": "cd dist && zip -r ../bigbrowser-chrome.zip . -x '*.map'"
	},
	"devDependencies": {
		"@bigbrowser/core": "4.0.0",
		"copy-webpack-plugin": "^12.0.2",
		"ts-loader": "^9.5.2",
		"typescript": "^5.7.3",
		"webpack": "^5.97.1",
		"webpack-cli": "^5.1.4"
	}
}
