{
	"compilerOptions": {
		"noImplicitAny": true,
		"outDir": "build/types",
		"module": "esnext",
		"target": "es2017",
		"moduleResolution": "node",
		"allowJs": true,
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"sourceMap": true,
		"declaration": true,
		"emitDeclarationOnly": true,
		"strict": true,
		"skipLibCheck": true,
		"lib": [
			"dom",
			"es2019"
		]
	},
	"include": [
		"src/lib/**/*",
		"src/globals.d.ts",
		"ts_modules/*.d.ts"
	],
	"exclude": [
		"src/lib/**/tests"
	]
}
