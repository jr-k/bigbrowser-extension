{
	"name": "@bigbrowser/core",
	"version": "4.0.0",
	"description": "Big Browser core: SDK for plugin authors and runtime orchestrating tweaks on a page",
	"main": "build/index.js",
	"types": "build/types/index.d.ts",
	"files": [
		"build"
	],
	"scripts": {
		"start": "webpack serve --config webpack.config.sandbox.js",
