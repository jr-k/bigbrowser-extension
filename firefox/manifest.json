{
	"manifest_version": 3,
	"name": "Big Browser",
	"version": "4.0.0",
	"description": "Big browser is not watching you. Subscribe to plugins and pick the tweaks you want on each site.",
	"icons": {
		"16": "icons/icon-16.png",
		"32": "icons/icon-32.png",
		"48": "icons/icon-48.png",
		"128": "icons/icon-128.png"
	},
	"browser_specific_settings": {
		"gecko": {
			"id": "bigbrowser@jr-k.github.io",
			"strict_min_version": "136.0"
		}
	},
	"permissions": ["storage", "alarms", "activeTab"],
	"optional_permissions": ["userScripts"],
	"background": {
		"scripts": ["background.js"]
	},
	"action": {
		"default_title": "Big Browser",
		"default_popup": "popup.html",
		"default_icon": {
			"16": "icons/icon-16.png",
			"32": "icons/icon-32.png"
		}
	},
	"options_ui": {
		"page": "options.html",
		"open_in_tab": true
	}
}
